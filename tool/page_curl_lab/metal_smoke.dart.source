import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'dart:typed_data';
import 'dart:ui' as ui;

import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:flutter/rendering.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:integration_test/integration_test.dart';
import 'package:path_provider/path_provider.dart';

import '__LAB_MAIN_URI__' as lab;
import '__LAB_METAL_URI__';
import '__LAB_SOURCES_URI__';
import '__LAB_REAL_URI__';

void main() {
  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
  testWidgets('Metal texture, hardware depth, real books and page recovery', (
    tester,
  ) async {
    final directory = Directory(
      const String.fromEnvironment('CURL_METAL_SMOKE_OUTPUT').isEmpty
          ? '${Directory.systemTemp.path}/curl-metal-smoke'
          : const String.fromEnvironment('CURL_METAL_SMOKE_OUTPUT'),
    )..createSync(recursive: true);
    final cases = <Map<String, Object?>>[];
    Future<void> report(String status, {Object? error}) =>
        File('${directory.path}/results.json').writeAsString(
          jsonEncode({
            'run_id': const String.fromEnvironment('CURL_SMOKE_RUN_ID'),
            'status': status,
            'platform': Platform.operatingSystem,
            'simulator': lab.simulated,
            'renderer': 'metal',
            'performance_statistics_usable': false,
            'cases': cases,
            'gesture_delivery': 'Flutter integration-test pointer events',
            'os_touch_interruption_verified': false,
            if (error != null) 'error_type': error.runtimeType.toString(),
          }),
        );
    Future<void> collect() async {
      final watch = Stopwatch()..start();
      while (!File('${directory.path}/collected').existsSync()) {
        if (watch.elapsed > const Duration(seconds: 30))
          fail('Host did not collect Metal report');
        await Future<void>.delayed(const Duration(milliseconds: 100));
      }
    }

    final surface = find.byKey(const Key('curl-surface'));
    Future<void> waitPage(int page) async {
      final watch = Stopwatch()..start();
      while (watch.elapsed < const Duration(seconds: 30)) {
        await tester.pump(const Duration(milliseconds: 50));
        expect(tester.takeException(), isNull);
        if (find.textContaining('· page $page ·').evaluate().isNotEmpty &&
            surface.evaluate().isNotEmpty) {
          await tester.pumpAndSettle(
            const Duration(milliseconds: 50),
            EnginePhase.sendSemanticsUpdate,
            const Duration(seconds: 5),
          );
          final native = find.byType(MetalCurlSurface);
          if (native.evaluate().isNotEmpty) {
            final view = tester.widget<MetalCurlSurface>(native);
            await view.controller.settled;
            if (view.progress != 0) continue;
          }
          return;
        }
      }
      fail('Page did not settle');
    }

    Future<ui.Image> flutterImage() async {
      await tester.pump();
      return tester
          .renderObject<RenderRepaintBoundary>(
            find
                .ancestor(of: surface, matching: find.byType(RepaintBoundary))
                .first,
          )
          .toImage(pixelRatio: tester.view.devicePixelRatio);
    }

    Future<Uint8List> nativePixels(String shot) async {
      final view = tester.widget<MetalCurlSurface>(
        find.byType(MetalCurlSurface),
      );
      final image = await view.controller.snapshot();
      final width = (image['width']! as num).toInt(),
          height = (image['height']! as num).toInt(),
          stride = (image['stride']! as num).toInt();
      final bytes = image['bgra']! as Uint8List;
      final tight = Uint8List(width * height * 4);
      for (var row = 0; row < height; row++)
        tight.setRange(
          row * width * 4,
          (row + 1) * width * 4,
          bytes,
          row * stride,
        );
      final completer = Completer<ui.Image>();
      ui.decodeImageFromPixels(
        tight,
        width,
        height,
        ui.PixelFormat.bgra8888,
        completer.complete,
      );
      final decoded = await completer.future;
      final png = await decoded.toByteData(format: ui.ImageByteFormat.png);
      await File('${directory.path}/$shot.png')
          .writeAsBytes(png!.buffer.asUint8List());
      decoded.dispose();
      return tight;
    }

    Future<void> drag(
      double fraction, {
      bool cancel = false,
      double y = .5,
      String? shot,
    }) async {
      final view = tester.widget<MetalCurlSurface>(
        find.byType(MetalCurlSurface),
      );
      final rect = tester.getRect(surface);
      final start = Offset(
        fraction > 0 ? rect.left + 16 : rect.right - 16,
        rect.top + rect.height * y,
      );
      final gesture = await tester.startGesture(start);
      final distance = rect.width / (view.spread ? 2 : 1) * fraction;
      for (var i = 0; i < 10; i++) {
        await gesture.moveBy(Offset(distance / 10, 0));
        await tester.pump(const Duration(milliseconds: 35));
      }
      if (shot != null) await nativePixels(shot);
      await tester.pump(const Duration(milliseconds: 120));
      if (cancel) {
        await gesture.cancel();
      } else {
        await gesture.up();
      }
    }

    try {
      File('${directory.path}/collected').deleteSyncIfExists();
      await report('awaiting-inputs');
      if (const bool.fromEnvironment('CURL_INPUT_DOCUMENTS')) {
        final docs = await getApplicationDocumentsDirectory();
        final watch = Stopwatch()..start();
        while (![
          'epub',
          'cbz',
          'pdf',
        ].every((e) => File('${docs.path}/input.$e').existsSync())) {
          if (watch.elapsed > const Duration(seconds: 30))
            fail('Inputs absent');
          await Future<void>.delayed(const Duration(milliseconds: 100));
        }
      }
      await lab.main();
      await waitPage(1);
      for (final kind in PageKind.values) {
        if (kind != PageKind.text) {
          await tester.tap(find.byType(DropdownButton<PageKind>));
          await tester.pumpAndSettle();
          await tester.tap(find.text(kind.name).last);
          await waitPage(1);
        }
        for (final spread in [false, true]) {
          if (find
              .text(spread ? 'Double page' : 'Single page')
              .evaluate()
              .isEmpty) {
            await tester.tap(find.text(spread ? 'Single page' : 'Double page'));
            await waitPage(1);
          }
          final host = tester.widget<RealPageHost>(find.byType(RealPageHost));
          expect(host.source.metadata['source_is_real'], true);
          final reference = await flutterImage();
          final referenceBytes = (await reference.toByteData())!.buffer
              .asUint8List();
          await tester.tap(find.text('Renderer: mesh'));
          await waitPage(1);
          final view = tester.widget<MetalCurlSurface>(
            find.byType(MetalCurlSurface),
          );
          final stats = await view.controller.metrics();
          expect(stats['depth_test'], true);
          expect(stats['msaa'], 4);
          final name = '${kind.name}-${spread ? 'double' : 'single'}';
          final initial = await nativePixels('$name-front');
          final w = (stats['width']! as num).toInt(),
              h = (stats['height']! as num).toInt();
          expect([reference.width, reference.height], [w, h]);
          var difference = 0;
          for (var i = 0; i < initial.length; i += 4) {
            difference +=
                (initial[i + 2] - referenceBytes[i]).abs() +
                (initial[i + 1] - referenceBytes[i + 1]).abs() +
                (initial[i] - referenceBytes[i + 2]).abs();
          }
          final referenceMAE = difference / (w * h * 3);
          expect(
            referenceMAE,
            lessThan(5),
            reason: 'Native page color/order differs from CPU mesh',
          );
          reference.dispose();
          final composite = await flutterImage();
          final compositeBytes = (await composite.toByteData())!.buffer
              .asUint8List();
          var compositeDiff = 0;
          for (var i = 0; i < initial.length; i += 4) {
            compositeDiff +=
                (initial[i + 2] - compositeBytes[i]).abs() +
                (initial[i + 1] - compositeBytes[i + 1]).abs() +
                (initial[i] - compositeBytes[i + 2]).abs();
          }
          final compositeMAE = compositeDiff / (w * h * 3);
          expect(
            compositeMAE,
            lessThan(5),
            reason: 'Flutter external texture capture differs',
          );
          composite.dispose();
          final step = spread ? 2 : 1;
          await tester.tap(find.text('Next'));
          await waitPage(1 + step);
          await tester.tap(find.text('Previous'));
          await waitPage(1);
          await drag(-.8, shot: '$name-curl');
          await waitPage(1 + step);
          await drag(.8);
          await waitPage(1);
          await drag(-.08);
          await waitPage(1);
          for (final y in [.15, .85]) {
            await drag(-.55, cancel: true, y: y, shot: '$name-corner-$y');
            await waitPage(1);
          }
          await tester.tap(find.text('Next'));
          await waitPage(1 + step);
          await drag(.65, cancel: true);
          await waitPage(1 + step);
          await tester.tap(find.text('Previous'));
          await waitPage(1);
          await tester.tap(find.text('LTR'));
          await tester.pumpAndSettle();
          await drag(.8);
          await waitPage(1 + step);
          await drag(-.8);
          await waitPage(1);
          await tester.tap(find.text('RTL'));
          await tester.pumpAndSettle();
          final restored = await nativePixels('$name-returned');
          expect(
            listEquals(initial, restored),
            true,
            reason: 'Native pixel restoration differs',
          );
          cases.add({
            'format': kind.name,
            'spread': spread,
            'passed': true,
            'cpu_reference_rgb_mae': referenceMAE,
            'flutter_composite_rgb_mae': compositeMAE,
            'width': w,
            'height': h,
            'depth_test': true,
            'msaa': 4,
            'checks': [
              'real source',
              'CPU endpoint reference',
              'Flutter texture composition',
              'button forward/back',
              'drag forward/back',
              'short rebound',
              'corner cancellation',
              'reverse cancellation',
              'RTL',
              'restored native pixels identical',
            ],
          });
          await report('running');
          await tester.tap(find.text('Renderer: metal'));
          await waitPage(1);
        }
        await tester.tap(find.text('Double page'));
        await waitPage(1);
      }
      await report('passed');
      await collect();
      await tester.pumpWidget(const SizedBox.shrink());
      await tester.pump();
    } catch (error) {
      await report('failed', error: error);
      await collect();
      rethrow;
    }
  });
}

extension on File {
  void deleteSyncIfExists() {
    if (existsSync()) deleteSync();
  }
}
